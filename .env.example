# Copy to .env.local and fill in. Never commit .env.local.

# LLM transport (A7). "claude-code" (default) rides the locally installed and
# logged-in Claude Code CLI, so local runs need no ANTHROPIC_API_KEY. "api-key"
# uses the @anthropic-ai/sdk client and requires ANTHROPIC_API_KEY below.
LLM_TRANSPORT=claude-code

# Optional (claude-code transport only). Path to the claude executable, if it is
# not discoverable on PATH. Leave unset to auto-discover.
# CLAUDE_CODE_BIN=

# Optional (claude-code transport only). Per-call timeout in milliseconds.
# Defaults to 600000 (10 minutes). Kills the child and surfaces a timeout error.
# CLAUDE_CODE_TIMEOUT_MS=600000

# Anthropic API key, server-side only, never exposed to the client. OPTIONAL:
# required only for the api-key transport (LLM_TRANSPORT=api-key). The default
# claude-code transport does not use it.
ANTHROPIC_API_KEY=

# Single shared password for the login gate.
APP_PASSWORD=

# Deploy-time DEFAULT models (A8). These are the fallback when no per-purpose
# override is set on the /settings page. DRAFT_MODEL covers drafting and revision;
# UTILITY_MODEL covers interrogation, summaries, canon extraction, sweeps, chat, and
# bible import. A per-purpose override in the settings table wins over these; if a
# var is unset, the built-in fallback (claude-sonnet-4-6) applies. Set the model per
# purpose at runtime on /settings.
DRAFT_MODEL=claude-sonnet-4-6
UTILITY_MODEL=claude-sonnet-4-6

# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Path to the SQLite database file. Defaults to ./data/bookforge.db
# DATABASE_PATH=./data/bookforge.db

# Listen and voice notes (A14). Both point at on-box loopback services and are
# OPTIONAL: when a URL is unset, that half of the feature renders nothing and its
# routes 404, so local dev without the services sees no change. TTS_SERVICE_URL is
# a Piper neural TTS server (POST /speak with JSON {"text"} returns a WAV; GET
# /health returns {"ok":true}). STT_SERVICE_URL is a whisper.cpp server (POST
# /inference with a multipart audio field `file` returns JSON {"text"}). On the
# deployed box these are http://127.0.0.1:3108 and http://127.0.0.1:3107. The test
# loop never calls them: USE_FIXTURE_LLM=1 serves a tiny WAV and a canned transcript.
# TTS_SERVICE_URL=http://127.0.0.1:3108
# STT_SERVICE_URL=http://127.0.0.1:3107

# Optional (A14). Voice id that namespaces the audio cache key (default "default")
# and the on-disk cache cap in bytes (default 2 GB, oldest-first prune).
# AUDIO_VOICE_ID is part of the content-addressed audio cache key, so it MUST
# change whenever the TTS voice changes: audio synthesized under one voice id
# never collides with or is served for another. On the A19 Kokoro flip it becomes
# "kokoro-af_heart" alongside TTS_SERVICE_URL=http://127.0.0.1:3110, and the old
# Piper audio simply ages out of the cap as each chapter re-synthesizes in the new
# voice on next listen (see DEPLOY.md). Reverting the voice id restores the old
# cache namespace.
# AUDIO_VOICE_ID=default
# AUDIO_CACHE_MAX_BYTES=2147483648

# Crash reporting (uh-oh, self-hosted; https://github.com/cunninghambe/uh-oh).
# Both optional: format https://<publicKey>@<uh-oh-host>[:port][/pathPrefix].
# Leave unset to disable (the client is a silent no-op without a DSN). UH_OH_DSN
# covers server-side code (instrumentation.ts, the MCP server). NEXT_PUBLIC_UH_OH_DSN
# covers the browser and is a NEXT_PUBLIC_ var, so it is inlined into the client
# bundle at BUILD time, not read at runtime: for Docker/Fly deploys it must be
# passed as a build arg (see DEPLOY.md), not just a runtime secret.
# UH_OH_DSN=
# NEXT_PUBLIC_UH_OH_DSN=
