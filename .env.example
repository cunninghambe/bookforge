# Copy to .env.local and fill in. Never commit .env.local.

# LLM transport (A7). "claude-code" (default) rides the locally installed and
# logged-in Claude Code CLI, so local runs need no ANTHROPIC_API_KEY. "api-key"
# uses the @anthropic-ai/sdk client and requires ANTHROPIC_API_KEY below.
LLM_TRANSPORT=claude-code

# Optional (claude-code transport only). Path to the claude executable, if it is
# not discoverable on PATH. Leave unset to auto-discover.
# CLAUDE_CODE_BIN=

# Optional (claude-code transport only). Per-call timeout in milliseconds.
# Defaults to 600000 (10 minutes). Kills the child and surfaces a timeout error.
# CLAUDE_CODE_TIMEOUT_MS=600000

# Anthropic API key, server-side only, never exposed to the client. OPTIONAL:
# required only for the api-key transport (LLM_TRANSPORT=api-key). The default
# claude-code transport does not use it.
ANTHROPIC_API_KEY=

# Single shared password for the login gate.
APP_PASSWORD=

# Prose generation and revision. Stronger model can go here.
DRAFT_MODEL=claude-sonnet-4-6

# Interrogation, summaries, canon extraction, sweeps.
UTILITY_MODEL=claude-sonnet-4-6

# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Path to the SQLite database file. Defaults to ./data/bookforge.db
# DATABASE_PATH=./data/bookforge.db
